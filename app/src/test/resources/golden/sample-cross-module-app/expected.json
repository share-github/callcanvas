      "code": "    /**\n     * 結果コードが成功かどうかを判定する\n     *\n     * @param resultCode 結果コード\n     * @return true:成功 false:失敗\n     */\n    public boolean checkResultCode(String resultCode) {\n        return SUCCESS.equals(resultCode);\n    }",
