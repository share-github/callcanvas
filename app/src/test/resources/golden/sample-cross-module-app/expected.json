      }],
      "code": "    /**\n     * 注文を外部APIに送信する\n     *\n     * @param request 注文リクエスト\n     * @return 注文結果\n     */\n    public OrderResult submitOrder(OrderRequest request) {\n        // 外部APIへのHTTPリクエスト処理\n        OrderResult result = new OrderResult();\n        result.setResultCode(SUCCESS);\n        result.setReceptionNo(\"REC-\" + System.currentTimeMillis());\n        result.setMessage(\"注文受付完了\");\n        return result;\n    }",
      "displayName": "ExternalApiComponent # submitOrder",
      "startLine": 16,
      "filePath": "module-core/src/main/java/com/example/core/component/ExternalApiComponent.java",
      "id": "window-5"
    },
    {
