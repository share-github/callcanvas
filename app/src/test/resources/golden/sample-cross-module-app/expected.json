          "field": "com.example.front.service.FrontService#externalApiComponent",
          "line": 42
        }
      ],
      "code": "    /**\n     * 注文処理を実行する\n     *\n     * ★ このメソッドを \"CallCanvas: Open Viewer with File\" で解析すると、\n     *   ExternalApiComponent#submitOrder() が解析されない（不具合）\n     *\n     * @param form      注文フォーム\n     * @param customerId 顧客ID\n     * @return 受付番号\n     */\n    public String processOrder(OrderFormDto form, String customerId) {\n        // リクエスト組み立て\n        OrderRequest request = new OrderRequest();\n        request.setCustomerId(customerId);\n        request.setItemCode(form.getItemCode());\n\n        // ★ ここで ExternalApiComponent#submitOrder() を呼び出す\n        // call-index.json には \"ExternalApiComponent#submitOrder(...)\" と不完全FQNで記録される\n        OrderResult result = externalApiComponent.submitOrder(request);\n\n        // 結果コードチェック\n        // call-index.json には \"ExternalApiComponent#checkResultCode(...)\" と不完全FQNで記録される\n        if (!externalApiComponent.checkResultCode(result.getResultCode())) {\n            throw new RuntimeException(\"API error: \" + result.getMessage());\n        }\n\n        // 後続処理\n        String receptionNo = result.getReceptionNo();\n        sendConfirmationMail(customerId, receptionNo);\n\n        return receptionNo;\n    }",
      "displayName": "FrontService # processOrder",
      "startLine": 20,
      "filePath": "module-front/src/main/java/com/example/front/service/FrontService.java",
      "id": "window-1"
    },
    {
      "code": "    /**\n     * 確認メールを送信する\n     *\n     * @param customerId  顧客ID\n     * @param receptionNo 受付番号\n     */\n    private void sendConfirmationMail(String customerId, String receptionNo) {\n        // メール送信処理（省略）\n        System.out.println(\"Mail sent to: \" + customerId + \", receptionNo: \" + receptionNo);\n    }",
