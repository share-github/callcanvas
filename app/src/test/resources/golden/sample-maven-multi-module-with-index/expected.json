      "code": "    public PaymentResult processPayment(Order order, String paymentMethod) {\n        if (!validatePaymentMethod(paymentMethod)) {\n            return PaymentResult.failure(\"Invalid payment method\");\n        }\n\n        if (!checkFunds(order.getAmount())) {\n            return PaymentResult.failure(\"Insufficient funds\");\n        }\n\n        executePayment(order, paymentMethod);\n        return PaymentResult.success();\n    }",
