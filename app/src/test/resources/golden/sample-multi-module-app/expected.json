      "code": "    /**\n     * 注文を作成して処理する\n     */\n    public PaymentResult createAndProcessOrder(Order order, String paymentMethod) {\n        // 注文を検証\n        if (!orderProcessor.validate(order)) {\n            return PaymentResult.failure(\"Order validation failed\");\n        }\n\n        // 注文を処理\n        orderProcessor.processOrder(order);\n\n        // 支払いを処理\n        PaymentResult result = paymentService.processPayment(order, paymentMethod);\n        \n        if (result.isSuccess()) {\n            order.setStatus(OrderStatus.PAID);\n        } else {\n            orderProcessor.cancelOrder(order);\n        }\n\n        return result;\n    }",
