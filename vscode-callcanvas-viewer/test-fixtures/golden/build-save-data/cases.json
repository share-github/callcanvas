[
  {
    "label": "Standard save with highlight and comment",
    "input": {
      "autoLayout": true,
      "windows": [
        {
          "id": "w1",
          "displayName": "Foo # bar",
          "filePath": "Foo.java",
          "startLine": 10,
          "position": {
            "top": 80,
            "left": 40,
            "width": 600,
            "height": 200
          },
          "collapsed": false,
          "visible": true,
          "fullHeight": false,
          "code": [
            {
              "line": 10,
              "content": "public void bar() {",
              "highlight": true,
              "comment": "entry point"
            },
            {
              "line": 11,
              "content": "    baz();",
              "highlight": false
            },
            {
              "line": 12,
              "content": "}",
              "highlight": false
            }
          ]
        }
      ],
      "connections": [
        {
          "from": "w1",
          "to": "w2"
        }
      ]
    },
    "expected": {
      "autoLayout": true,
      "windows": [
        {
          "highlightLines": [
            10
          ],
          "code": "public void bar() {\n    baz();\n}",
          "displayName": "Foo # bar",
          "filePath": "Foo.java",
          "startLine": 10,
          "id": "w1",
          "position": {
            "top": 80,
            "left": 40,
            "width": 600,
            "height": 200
          },
          "collapsed": false,
          "visible": true,
          "fullHeight": false,
          "lineComments": {
            "10": "entry point"
          }
        }
      ],
      "connections": [
        {
          "from": "w1",
          "to": "w2"
        }
      ]
    }
  },
