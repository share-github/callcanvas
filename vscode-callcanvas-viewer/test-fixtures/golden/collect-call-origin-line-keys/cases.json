  {
    "label": "two edges same line deduped in Set",
    "input": {
      "currentData": {
        "connections": [
          {
            "from": "w1",
            "to": "w2",
            "callLine": 5
          },
          {
            "from": "w1",
            "to": "w3",
            "callLine": 5
          }
        ]
      }
    },
    "expected": [
