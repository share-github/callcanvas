[
  {
    "label": "delete a leaf: its connection goes, caller stays",
    "input": {
      "connections": [
        {
          "from": "window-1",
          "to": "window-2",
          "callLine": 36,
          "callEndLine": 36
        },
        {
          "from": "window-1",
          "to": "window-3",
          "callLine": 36,
          "callEndLine": 36
        }
      ],
      "ids": [
        "window-3"
      ]
    },
    "expected": {
      "deleteIds": [
        "window-3"
      ],
      "connections": [
        {
          "from": "window-1",
          "to": "window-2",
          "callLine": 36,
          "callEndLine": 36
        }
      ]
    }
  },
  {
    "label": "delete the caller: callees reached only from it cascade",
    "input": {
      "connections": [
        {
          "from": "window-1",
          "to": "window-2",
          "callLine": 36,
          "callEndLine": 36
        },
        {
          "from": "window-1",
          "to": "window-3",
          "callLine": 36,
          "callEndLine": 36
        }
      ],
      "ids": [
        "window-1"
      ]
    },
    "expected": {
      "deleteIds": [
        "window-1",
        "window-2",
        "window-3"
      ],
      "connections": []
    }
  },
  {
    "label": "callee called from two windows survives deleting one of them",
    "input": {
      "connections": [
        {
          "from": "window-1",
          "to": "window-3",
          "callLine": 36,
          "callEndLine": 36
        },
        {
          "from": "window-2",
          "to": "window-3",
          "callLine": 23,
          "callEndLine": 23
        }
      ],
      "ids": [
        "window-1"
      ]
    },
    "expected": {
      "deleteIds": [
        "window-1"
      ],
      "connections": [
        {
          "from": "window-2",
          "to": "window-3",
          "callLine": 23,
          "callEndLine": 23
        }
      ]
    }
  },
  {
    "label": "no connections",
    "input": {
      "connections": [],
      "ids": [
        "a"
      ]
    },
    "expected": {
      "deleteIds": [
        "a"
      ],
      "connections": []
    }
  }
]
