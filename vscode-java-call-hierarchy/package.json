{
  "name": "java-call-hierarchy",
  "displayName": "Java Call Hierarchy Analyzer",
  "description": "Analyze and visualize Java method call hierarchies",
  "version": "0.20.0",
  "publisher": "share-github",
  "license": "MIT",
  "author": "share-github",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "javaCallHierarchy.analyze",
        "title": "Analyze Call Hierarchy",
        "category": "Java Call Hierarchy"
      },
      {
        "command": "javaCallHierarchy.exportCallCanvas",
        "title": "Export Call Hierarchy as CallCanvas JSON",
        "category": "Java Call Hierarchy"
      },
      {
        "command": "javaCallHierarchy.exportCallCanvasClass",
        "title": "Export Call Hierarchy as CallCanvas JSON (Class)",
        "category": "Java Call Hierarchy"
      },
      {
        "command": "javaCallHierarchy.openCallCanvasViewer",
        "title": "CallCanvas: Open Viewer with File",
        "category": "Java Call Hierarchy"
      },
      {
        "command": "javaCallHierarchy.buildIndex",
        "title": "Build Call Index",
        "category": "Java Call Hierarchy"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "javaCallHierarchy.analyze",
          "when": "editorLangId == java",
          "group": "navigation"
        },
        {
          "command": "javaCallHierarchy.openCallCanvasViewer",
          "when": "editorLangId == java",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Java Call Hierarchy",
      "properties": {
        "javaCallHierarchy.depth": {
          "type": "number",
          "default": 5,
          "description": "Maximum depth of call hierarchy analysis"
        },
        "javaCallHierarchy.excludePatterns": {
          "type": "string",
          "default": "**generated**,**config**,**dto**",
          "description": "Comma-separated patterns to exclude from analysis"
        },
        "javaCallHierarchy.javaPath": {
          "type": "string",
          "default": "",
          "description": "Path to Java executable (leave empty to use PATH)"
        },
        "javaCallHierarchy.languageLevel": {
          "type": "string",
          "default": "JAVA_21",
          "enum": [
            "JAVA_8",
            "JAVA_11",
            "JAVA_17",
            "JAVA_21",
            "JAVA_22",
            "JAVA_23",
            "JAVA_24",
            "JAVA_25"
          ],
          "enumDescriptions": [
            "Java 8",
            "Java 11",
            "Java 17",
            "Java 21 (default)",
            "Java 22",
            "Java 23 (/// Markdown Javadoc)",
            "Java 24",
            "Java 25 (module import declarations, flexible constructor bodies)"
          ],
          "description": "Java language level of the project being analyzed (not the Java used to run the analyzer)"
        },
        "javaCallHierarchy.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug output (shows detailed error messages)"
        },
        "javaCallHierarchy.quiet": {
          "type": "boolean",
          "default": false,
          "description": "Enable quiet mode (suppress logs, show only performance summary)"
        },
        "javaCallHierarchy.timing": {
          "type": "boolean",
          "default": false,
          "description": "Enable timing output (shows block-level performance metrics)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  }
}
